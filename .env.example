# ---------------------------------------------------------------------------
# Database — create a project at https://neon.tech and paste the POOLED
# connection string here (it ends with `-pooler.<region>.aws.neon.tech`).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/hunar_bazaar?sslmode=verify-full"

# ---------------------------------------------------------------------------
# Clerk — https://dashboard.clerk.com → API keys
# Enable Email, Google and Phone number (OTP) in User & Authentication.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Optional Clerk route overrides (defaults shown)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# ---------------------------------------------------------------------------
# Store configuration
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="Hunar Bazaar"
NEXT_PUBLIC_WHATSAPP_NUMBER="923001234567"
NEXT_PUBLIC_STORE_EMAIL="hello@hunarbazaar.pk"
NEXT_PUBLIC_STORE_PHONE="+92 300 1234567"

# Bank transfer details shown at checkout / on the order confirmation page.
NEXT_PUBLIC_BANK_NAME="Meezan Bank"
NEXT_PUBLIC_BANK_ACCOUNT_TITLE="Hunar Bazaar (Pvt) Ltd"
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER="01234567890123"
NEXT_PUBLIC_BANK_IBAN="PK00MEZN0000000123456789"

# ---------------------------------------------------------------------------
# Cloudinary (product image uploads from /admin)
# Create an UNSIGNED upload preset in Cloudinary → Settings → Upload.
# If these are empty, admins can still paste image URLs manually.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# ---------------------------------------------------------------------------
# Online payments — intentionally stubbed. Keep disabled until credentials
# and a server-side verification flow are in place.
# See src/lib/payments/README.md
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ONLINE_PAYMENTS="false"
SAFEPAY_API_KEY=""
SAFEPAY_SECRET_KEY=""
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""

# ---------------------------------------------------------------------------
# Optional: distributed rate limiting (recommended in production).
# The app ships with an in-memory limiter; swap it for Upstash Redis by
# installing @upstash/ratelimit and editing src/lib/rate-limit.ts.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
